# ============================================================
# Sistema SeS — Variables de entorno (Fase 1)
# ============================================================
# Copia este archivo como ".env" o inyecta estos valores en
# window.SNEAKERMANIA_ENV antes de cargar la app (ver README).
#
# Al ser una app 100% de navegador (sin bundler), solo se usan
# claves PÚBLICAS del proyecto Supabase. NUNCA pongas aquí la
# service_role key: expondría toda la base de datos.
# ------------------------------------------------------------

# URL del proyecto Supabase
SUPABASE_URL=https://ypgyfgbftfvouobmsync.supabase.co

# Clave pública (anon / publishable). Segura para el navegador
# porque las políticas RLS protegen los datos por tenant.
SUPABASE_ANON_KEY=sb_publishable_Hq4paRq4YxKnLskWN5ejng_3k9o6Oye
